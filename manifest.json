{
  "manifest_version": 3,
  "name": "Veyron OS - Modern Web Desktop",
  "version": "1.0.0",
  "description": "A lightweight, modern Windows 11-style desktop operating system running directly inside Google Chrome with interactive apps, custom audio, and file system.",
  "action": {
    "default_title": "Launch Veyron OS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ]
}
